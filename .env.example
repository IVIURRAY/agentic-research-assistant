# Copy to .env and fill in. Keep comments on their own lines (make and env-file parsers
# treat anything after the value as part of it).

# --- Required: OpenRouter (key from https://openrouter.ai/settings/keys) ---
# Free models: 20 requests/min, 50 requests/day (1000/day after buying $10 of credits).
OPENROUTER_API_KEY=
# Any OpenRouter model with tool calling works for the agent; the judge also needs
# structured outputs. Other free NVIDIA options: nvidia/nemotron-3-super-120b-a12b:free,
# nvidia/nemotron-3-ultra-550b-a55b:free,
# nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Optional: LangSmith (OTLP traces, eval experiments, thumbs feedback) ---
# Without a key, spans are created but not exported, and evals run locally.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-assistant
# EU accounts: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# To send traces somewhere else (Phoenix, Datadog, a collector), set instead:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces

# --- Retrieval ---
# local (cross-encoder) | cohere (needs COHERE_API_KEY + `uv sync --extra cohere`) | none
RERANKER=local
# COHERE_API_KEY=
TOP_K=8
MAX_AGENT_STEPS=8
